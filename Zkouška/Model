# Jednoduchý 0-D model elektrochemické komprese H2 (Python)
import numpy as np
import matplotlib.pyplot as plt
from scipy.constants import R, N_A

# Parametry
F = 96485.33212        # C/mol
z = 2                  # e-/H2
Vc = 0.01          # m^3 (objem zásobníku)
T = 298.15             # K
P_amb = 1.0e5          # Pa (atmosféra)
k_leak = 1e-8          # mol/(s·Pa) - odhad, uprav podle reálných dat
I = 10.0               # A (konstantní proud)
dt = 0.1               # s
t_end = 3600           # s (1 hodina)

# Inicializace
n = (P_amb * Vc) / (R * T)  # počáteční moly ideální plyn
times = np.arange(0, t_end+dt, dt)
P = np.zeros_like(times)
P[0] = P_amb

for k, t in enumerate(times[:-1]):
    # molární tok generovaný elektrolýzou
    n_dot_in = I / (z * F)  # mol/s

    # ztráty (permeace / netěsnost)
    n_dot_loss = k_leak * (P[k] - P_amb)

    # aktualizace počtu molů
    n = n + (n_dot_in - n_dot_loss) * dt

    # aktualizace tlaku
    P[k+1] = n * R * T / Vc

# Plot
plt.figure(figsize=(6,4))
plt.plot(times/60, P/1e5)
plt.xlabel('Čas (min)')
plt.ylabel('Tlak v zásobníku (bar)')
plt.title('Simulace 0-D elektrochemické komprese H2')
plt.grid(True)
plt.show()
